# Django Security Settings (CHANGE THESE FOR PRODUCTION!)
DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=True
# host.docker.internal нужен для локального стека мониторинга (Prometheus в Docker
# скрейпит приложение на хосте). В проде укажите реальные домены без него.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# HTTPS/SSL Settings (False for development; True for production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Rate Limiting
DJANGO_LOGIN_RATE_LIMIT=5
DJANGO_LOGIN_RATE_LIMIT_WINDOW=300
DJANGO_API_THROTTLE_ANON=30/min
DJANGO_API_THROTTLE_USER=120/min

# Session lifetime (seconds). Default: 14 days.
DJANGO_SESSION_COOKIE_AGE=1209600

# Content-Security-Policy (optional override; sensible default applied if empty)
# DJANGO_CSP=default-src 'self'

# Google OAuth 2.0 (leave empty to disable "Sign in with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/account/google/callback/ (prod: https://<host>/account/google/callback/)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google reCAPTCHA v2 ("I'm not a robot"). Leave empty to use the built-in
# arithmetic captcha (works offline). Get keys at https://www.google.com/recaptcha/admin
# Google's public TEST keys below always pass and show a "testing only" banner:
#   RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MU8tcbA
#   RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# reCAPTCHA version: v2 (checkbox) or v3 (invisible, score-based). Must match the
# type of your key in the Google admin console.
RECAPTCHA_VERSION=v2
# Minimum score (0.0–1.0) accepted for reCAPTCHA v3. Requests below it are rejected.
RECAPTCHA_MIN_SCORE=0.5

# ---------------------------------------------------------------------------
# Payments (PAY-002…PAY-006)
# ---------------------------------------------------------------------------
# PRO subscription price per month (Bereke charges KZT, PayPal charges USD).
SUBSCRIPTION_PRICE_KZT=5000
SUBSCRIPTION_PRICE_USD=9.99

# Public base URL used to build provider callbacks. For local webhook testing
# via ngrok (PAY-003), set this to your ngrok URL, e.g. https://xxxx.ngrok-free.app
PAYMENT_PUBLIC_BASE_URL=

# Bereke Bank ePay (PAY-002/PAY-003). Leave BEREKE_SANDBOX=True (or leave the
# secret empty) to use the built-in sandbox emulation — no bank keys required.
BEREKE_SANDBOX=True
BEREKE_API_BASE=https://testoauth.homebank.kz
BEREKE_CLIENT_ID=
BEREKE_CLIENT_SECRET=
BEREKE_TERMINAL=
BEREKE_CALLBACK_SECRET=bereke-sandbox-secret

# PayPal REST API Integration (PAY-006) — Real Payment Processing
# 
# ⚠️ IMPORTANT: This enables REAL PayPal payment processing for subscriptions.
#    Leave PAYPAL_CLIENT_SECRET empty to use sandbox mode with emulated payment form.
#    Set PAYPAL_MODE=live and provide credentials only in production with HTTPS!
#
# SETUP INSTRUCTIONS:
# 1. Go to https://developer.paypal.com (create account if needed)
# 2. Log in and go to Dashboard → Apps & Credentials
# 3. Switch to "Sandbox" tab for testing, or "Live" for production
# 4. Create an app under "REST API apps" (if not already created)
# 5. Click on app name to see:
#    - Client ID → set PAYPAL_CLIENT_ID
#    - Client Secret → set PAYPAL_CLIENT_SECRET
# 6. For Sandbox: Use PAYPAL_MODE=sandbox
#    For Production: Set PAYPAL_MODE=live (requires HTTPS + registered domain)
# 7. Setup Webhook (optional but recommended for robust payment confirmation):
#    - In PayPal Dashboard → Settings → Webhooks
#    - Create webhook with endpoint: https://yourdomain.com/payments/callback/paypal/
#    - Subscribe to events: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED
#    - Copy Webhook ID → set PAYPAL_WEBHOOK_ID
#    - Webhook signature token → set PAYPAL_WEBHOOK_SECRET

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_SECRET=paypal-sandbox-secret

# ---------------------------------------------------------------------------
# PostHog product analytics (Week 5)
# ---------------------------------------------------------------------------
# Leave POSTHOG_API_KEY empty to disable analytics entirely (graceful no-op —
# the app behaves exactly as before, no external calls). To enable:
#   1. Sign up free at https://posthog.com (EU: https://eu.posthog.com)
#   2. Project settings → Project API Key (starts with phc_...) → POSTHOG_API_KEY
#   3. Set POSTHOG_HOST to your region:
#        US: https://us.i.posthog.com   EU: https://eu.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Send personal data (email, name, username) to PostHog Persons. True (default)
# satisfies the "Persons show email/name" deliverable. Set False for a privacy /
# GDPR-friendly mode that sends only anonymous plan/role. The client also honors
# the browser Do-Not-Track header regardless of this setting.
POSTHOG_CAPTURE_PII=True

# Approximate USD->KZT rate used to convert PayPal (USD) orders to KZT when
# computing MRR/ARPU, so mixed-currency orders aren't summed as one currency.
USD_TO_KZT_RATE=475

# Default value for the 'pro-upsell-banner' feature flag, used when analytics is
# off or PostHog returns no value. With a key set, the real value comes from the
# PostHog feature flag (toggle it there with no redeploy).
FLAG_PRO_UPSELL_BANNER=True

# File Uploads
DJANGO_AVATAR_MAX_UPLOAD_SIZE=2097152
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=2621440

# Database (Railway will provide DATABASE_URL automatically)
# DATABASE_URL=postgres://user:pass@host:port/dbname

# Backup Settings
DJANGO_BACKUP_DIR=./backups
DJANGO_BACKUP_COMPRESS=True

# APScheduler Settings (for automatic backups)
DJANGO_SCHEDULER_ENABLED=True
DJANGO_BACKUP_SCHEDULE_ENABLED=True
DJANGO_BACKUP_SCHEDULE_HOUR=2
DJANGO_BACKUP_SCHEDULE_MINUTE=0

# Optional: Cloud backup settings
# BACKUP_UPLOAD_SERVICE=s3  # or 'google_drive' or 'network'
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
# BACKUP_NETWORK_PATH=/mnt/backups
