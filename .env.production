# Django Security Settings for PRODUCTION
# ВАЖНО: Замените значения на ваши собственные!
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY
DJANGO_DEBUG=False

# Hosts and CSRF Protection (замените на ваш домен)
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,yourdomain.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://yourdomain.railway.app

# HTTPS/SSL Settings - ENABLED FOR PRODUCTION
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Rate Limiting
DJANGO_LOGIN_RATE_LIMIT=5
DJANGO_LOGIN_RATE_LIMIT_WINDOW=300
DJANGO_API_THROTTLE_ANON=30/min
DJANGO_API_THROTTLE_USER=120/min

# File Upload Limits
DJANGO_AVATAR_MAX_UPLOAD_SIZE=2097152
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=2621440

# Database (используйте полное значение DATABASE_URL от вашего хостера)
# Пример для Railway:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Redis: кэш (RedisCache) + брокер Celery. На Render подключается автоматически
# из сервиса cohub-redis (см. render.yaml). Пусто → LocMemCache и Celery в eager.
# REDIS_URL=redis://host:6379/0

# Backup Settings
DJANGO_BACKUP_DIR=./backups
DJANGO_BACKUP_COMPRESS=True

# Scheduling (APScheduler)
DJANGO_SCHEDULER_ENABLED=True
DJANGO_BACKUP_SCHEDULE_ENABLED=True
DJANGO_BACKUP_SCHEDULE_HOUR=2
DJANGO_BACKUP_SCHEDULE_MINUTE=0
